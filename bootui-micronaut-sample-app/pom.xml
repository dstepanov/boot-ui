<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.julien-dubois.bootui</groupId>
        <artifactId>bootui-micronaut-parent</artifactId>
        <version>1.16.0</version>
        <relativePath>../bootui-micronaut-parent/pom.xml</relativePath>
    </parent>

    <artifactId>bootui-micronaut-sample-app</artifactId>
    <name>BootUI :: Micronaut Sample App</name>
    <description>Reference Micronaut application that runs the BootUI console, mirroring the Spring and
        Quarkus sample apps. Never published to Maven Central.</description>

    <properties>
        <!-- Reference application, not a published artifact. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!--
            Overridable on the command line, so `-Dmicronaut.environments=prod` still reaches the forked JVM
            below: exec:exec passes fixed <arguments>, not the ambient system properties exec:java inherits.
        -->
        <micronaut.environments>dev</micronaut.environments>
        <micronaut.server.port>8080</micronaut.server.port>
        <!-- Pinned rather than left to Maven's "latest release" resolution, so an offline build of this
             module resolves the plugin it already has. -->
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-micronaut</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-server-netty</artifactId>
        </dependency>
        <!-- The application's JSON stack, and this module's second job: bootui-micronaut depends on neither
             Micronaut JSON stack, so this sample pins databind and BootUiJacksonDatabindSmokeTest runs the
             console's endpoints on it. The adapter's own tests run the same endpoints under
             micronaut-serde-jackson; the two stacks cannot share a classpath, which is why the promise that
             BootUI works on both is kept by two modules. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-jackson-databind</artifactId>
        </dependency>
        <!-- Lights up the Health panel with real indicators. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-management</artifactId>
        </dependency>
        <!-- Lights up the Metrics panel with a real Micrometer registry. -->
        <dependency>
            <groupId>io.micronaut.micrometer</groupId>
            <artifactId>micronaut-micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Lights up the Fault Tolerance panel with real @Retryable/@CircuitBreaker policies. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-retry</artifactId>
        </dependency>
        <!-- Lights up the WebSockets panel with a real @ServerWebSocket endpoint. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micronaut.test</groupId>
            <artifactId>micronaut-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The shared, framework-neutral HTTP conformance contract + JDK-HttpClient probe: this sample is
             the Micronaut runner for the very same suite the Spring and Quarkus samples run. -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-conformance</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Runnable with `./mvnw -pl bootui-micronaut-sample-app exec:exec`.

                exec:exec, not exec:java: exec:java runs the application inside Maven's own JVM, where
                `java.class.path` describes the Maven launcher rather than the application. BootUI's
                Vulnerabilities panel builds its inventory from the runtime classpath, and started that way
                it used to report exactly one dependency — `org.apache.maven.wrapper:maven-wrapper`. The
                adapter now also reads the application classloader so it survives an in-process launcher,
                but a sample that demonstrates the console should run the way a real application does: its
                own JVM, its own classpath, its own logging configuration.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>-Dmicronaut.environments=${micronaut.environments}</argument>
                        <argument>-Dmicronaut.server.port=${micronaut.server.port}</argument>
                        <argument>io.github.jdubois.bootui.micronautsample.BootUiMicronautSampleApplication</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
