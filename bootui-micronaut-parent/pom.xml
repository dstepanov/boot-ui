<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.julien-dubois.bootui</groupId>
        <artifactId>bootui-parent</artifactId>
        <version>1.16.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bootui-micronaut-parent</artifactId>
    <packaging>pom</packaging>
    <name>BootUI :: Micronaut Parent</name>
    <description>Shared Micronaut dependency and plugin management for the BootUI Micronaut modules.</description>

    <!--
        Keep the Micronaut BOM one inheritance level closer than bootui-parent's Spring Boot BOM. Maven's
        nearest-wins dependency management then gives every Micronaut module the platform-tested versions of
        shared libraries such as Jackson, Netty, and JUnit without affecting the Spring or Quarkus modules.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.micronaut.platform</groupId>
                <artifactId>micronaut-platform</artifactId>
                <version>${micronaut.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Micronaut wires beans at build time through its own annotation processor, so every
                    Micronaut module compiles with micronaut-inject-java on the processor path. Declared
                    here so the adapter, its tests, and the sample app cannot drift.
                -->
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <!--
                                micronaut-core-processor is pinned ahead of the processors that pull it in.
                                <annotationProcessorPaths> is resolved outside dependencyManagement, so the
                                platform BOM does not mediate it: micronaut-serde-processor declares its own,
                                older micronaut-core-bom, and without this entry that older micronaut-core can
                                win and the compiler dies with NoClassDefFoundError on a class the newer
                                micronaut-inject-java was built against (io.micronaut.core.annotation.NullMarked).
                                A direct entry sits nearest and settles the version for both processors.
                            -->
                            <path>
                                <groupId>io.micronaut</groupId>
                                <artifactId>micronaut-core-processor</artifactId>
                                <version>${micronaut.core.version}</version>
                            </path>
                            <path>
                                <groupId>io.micronaut</groupId>
                                <artifactId>micronaut-inject-java</artifactId>
                                <version>${micronaut.core.version}</version>
                            </path>
                            <!--
                                micronaut-serde-processor turns the adapter's @SerdeImport declarations
                                (BootUiSerdeImports) into compile-time bean introspections for the shared,
                                deliberately annotation-free core DTOs. Without it those @SerdeImport
                                annotations are inert and every /bootui/api/** response fails under
                                micronaut-serde-jackson with "No serializable introspection present".

                                It is on the processor path of every Micronaut module rather than only the
                                adapter so the adapter's tests and the sample app compile identically; a
                                module that declares no @SerdeImport simply gets nothing from it.
                            -->
                            <path>
                                <groupId>io.micronaut.serde</groupId>
                                <artifactId>micronaut-serde-processor</artifactId>
                                <version>${micronaut.serde.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-parameters</arg>
                            <arg>-Amicronaut.processing.group=io.github.jdubois.bootui</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
