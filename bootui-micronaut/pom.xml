<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.julien-dubois.bootui</groupId>
        <artifactId>bootui-micronaut-parent</artifactId>
        <version>1.16.0</version>
        <relativePath>../bootui-micronaut-parent/pom.xml</relativePath>
    </parent>

    <artifactId>bootui-micronaut</artifactId>
    <name>BootUI :: Micronaut Adapter</name>
    <description>Micronaut adapter that serves the BootUI developer console — the Micronaut binding over the
        framework-neutral bootui-engine, the analogue of bootui-spring-autoconfigure on Spring Boot and of
        bootui-quarkus on Quarkus.</description>

    <dependencies>
        <!-- Framework-neutral DTO/wire contract: the immutable records the engine returns and this adapter
             serializes (imported directly by the controllers), declared explicitly rather than leaned on
             transitively through bootui-engine. -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-core</artifactId>
        </dependency>
        <!-- Framework-neutral engine (logic shared with the Spring and Quarkus adapters). -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-engine</artifactId>
        </dependency>
        <!-- bootui-ui ships the pre-built SPA under META-INF/resources/bootui/, served by the static-resource
             route this adapter registers programmatically — no Node required by consumers. -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-ui</artifactId>
        </dependency>

        <!-- Micronaut DI + HTTP server for the /bootui/api/** endpoints. Deliberately absent from this list
             is a Micronaut JSON stack: BootUI must not dictate the host's. The application chooses
             micronaut-serde-jackson (the default for a new Micronaut 4 application) or
             micronaut-jackson-databind, and the adapter serializes correctly under either — see
             BootUiSerdeImports, which supplies the compile-time introspections Serde needs for the shared,
             annotation-free core DTOs. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-inject</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-runtime</artifactId>
        </dependency>
        <!-- micronaut-http-server, NOT micronaut-http-server-netty: the adapter compiles against the
             server abstraction (@ServerFilter, StreamedFile/SystemFile, EmbeddedServer, the Router) and
             references no Netty type at all. Depending on the Netty runtime here would put a second server
             implementation on the classpath of every consumer that runs micronaut-servlet on Jetty, Tomcat
             or Undertow. The application brings its own server; this module only needs to be routable by
             whichever one that is. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-server</artifactId>
        </dependency>

        <!-- Plain Jackson 2 databind (the library, NOT micronaut-jackson-databind the JSON stack): BootUI's
             own internal JSON work — the MCP JSON-RPC envelope, the GitHub and OSV clients, the AI agent
             session parsers — reads and writes JSON with its own ObjectMapper instances. Keeping this a
             library dependency instead of a Micronaut JSON-stack dependency is what lets the adapter run on
             a Serde application: nothing here registers an ObjectMapper bean or a MessageBodyWriter, so the
             host's choice of JSON stack is untouched. Under micronaut-jackson-databind the host supplies the
             very same artifact, so nothing is duplicated. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Micronaut Serde annotations, compile-only (provided): needed solely to compile BootUiSerdeImports,
             the @SerdeImport holder that makes the annotation-free core DTOs serializable under
             micronaut-serde without annotating them. provided scope is NOT transitive, so an application on
             micronaut-jackson-databind is never dragged onto Serde; the @SerdeImport annotations are then
             simply absent at runtime (annotations that cannot be loaded are ignored by the JVM) and the
             generated introspections sit unused. -->
        <dependency>
            <groupId>io.micronaut.serde</groupId>
            <artifactId>micronaut-serde-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Reactor, for the server-sent-event streams the live panels (Log Tail, Exceptions) subscribe to.
             Declared explicitly because this module compiles against it, and because a library must not lean
             on a transitive dependency of whichever server runtime the application happens to run. -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Logback, compile-only (provided): needed solely to compile the Loggers panel binding
             (MicronautLoggerProvider), which reads and writes live logger levels through the Logback
             LoggerContext. provided scope is NOT transitive, so an application that depends on this adapter
             but uses another SLF4J backend never gets Logback pulled in; the provider then reports the panel
             unavailable instead of failing. Micronaut applications use Logback by default, so in practice it
             is supplied by the application itself. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut Security, compile-only (provided): needed solely to compile the Security Logs capture
             listener (MicronautSecurityEventCapture), which observes micronaut-security's login/logout
             application events into the shared SecurityEventBuffer. provided scope is NOT transitive, so an
             application that does not add micronaut-security never gets it on its classpath, and the listener
             bean is conditioned on the API actually being present. -->
        <dependency>
            <groupId>io.micronaut.security</groupId>
            <artifactId>micronaut-security</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- HikariCP, compile-only (provided): needed solely to compile the Database Connection Pools panel
             binding (MicronautHikariConnectionPoolProvider), which reads the live pool configuration and
             counters. provided scope is NOT transitive, so an application with no JDBC datasource never gets
             it, and the provider is only wired when the API is actually present. When an app DOES add
             micronaut-jdbc-hikari, Hikari is supplied by that module. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut Cache, compile-only (provided): needed solely to compile the Cache panel binding
             (MicronautCacheProvider), which reads the live cache topology from the application's
             SyncCache beans. provided scope is NOT transitive, so an application that does not add
             micronaut-cache-core never gets it, and the provider is only wired when the API is present. -->
        <dependency>
            <groupId>io.micronaut.cache</groupId>
            <artifactId>micronaut-cache-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut Flyway, compile-only (provided): needed solely to compile the Flyway panel binding
             (MicronautFlywayProvider), which reads the migration history and runs migrate/clean through the
             same per-datasource configuration micronaut-flyway itself uses. provided scope is NOT transitive,
             so an application without Flyway never gets it, and the provider is only wired when present. -->
        <dependency>
            <groupId>io.micronaut.flyway</groupId>
            <artifactId>micronaut-flyway</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut Liquibase, compile-only (provided): the Liquibase panel binding
             (MicronautLiquibaseProvider) reads the change-log history and runs the update action through the
             same per-datasource configuration micronaut-liquibase itself uses. Same non-transitive rationale
             as Flyway above. -->
        <dependency>
            <groupId>io.micronaut.liquibase</groupId>
            <artifactId>micronaut-liquibase</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Persistence and Hibernate ORM, compile-only (provided): needed solely to compile the
             Hibernate advisor's entity discovery and the Hibernate Statistics panel, which read the JPA
             metamodel and the SessionFactory's statistics. provided scope is NOT transitive, so an
             application with no JPA never gets them, and both bindings are wired only when the API is
             actually present. When an app DOES add micronaut-data-hibernate-jpa, both are supplied by it. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OpenTelemetry SDK, compile-only (provided): needed solely to compile the in-process span capture
             behind the Traces and AI Framework panels. provided scope is NOT transitive, so an application
             that does not add micronaut-tracing-opentelemetry never gets the SDK, and the capture beans are
             conditioned on it actually being present. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-trace</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut WebSocket, compile-only (provided): needed solely to compile the WebSockets panel
             bindings, which inventory @ServerWebSocket endpoints and observe session open/close events.
             provided scope is NOT transitive, so an application without WebSockets never gets it, and the
             beans are conditioned on the API actually being present. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-websocket</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut Email, compile-only (provided): needed solely to compile the Email Viewer capture,
             which wraps the application's email sender to record what it sends. provided scope is NOT
             transitive, so an application that sends no mail never gets it, and the capture is conditioned
             on the API actually being present. -->
        <dependency>
            <groupId>io.micronaut.email</groupId>
            <artifactId>micronaut-email</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut Kafka, compile-only (provided): needed solely to compile the Kafka panel's capture
             bindings, which wrap the Producer/Consumer beans micronaut-kafka creates so every send and every
             delivery is recorded. provided scope is NOT transitive, so an application that does not add
             micronaut-kafka never gets it on its classpath, and the capture beans are conditioned on the API
             actually being present. -->
        <dependency>
            <groupId>io.micronaut.kafka</groupId>
            <artifactId>micronaut-kafka</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut RabbitMQ, compile-only (provided): needed solely to compile the RabbitMQ panel's
             capture bindings, which wrap the channel pool micronaut-rabbitmq publishes and consumes through.
             Same non-transitive rationale as Kafka above. -->
        <dependency>
            <groupId>io.micronaut.rabbitmq</groupId>
            <artifactId>micronaut-rabbitmq</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Micronaut Management, compile-only (provided): needed solely to compile the Health panel binding
             (MicronautHealthProvider), which reads the aggregated health result through Micronaut's
             HealthMonitorTask/HealthAggregator. provided scope is NOT transitive, so an application that does
             not add micronaut-management never gets it on its classpath, and the provider is only wired when
             the API is actually present. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-management</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies. The adapter's own tests boot a real Micronaut server (@MicronautTest) so the
             filters, the controllers and the DI wiring are exercised together, exactly as the Quarkus
             adapter's white-box tests do with @QuarkusTest. -->

        <!-- The JSON stack these tests run under is micronaut-serde-jackson, on purpose: Serde is the default
             for a new Micronaut 4 application and is the stricter of the two (it refuses any type without a
             compile-time introspection), so booting the whole console on it proves BootUiSerdeImports is
             complete for every endpoint the smoke test walks. The other stack is covered by
             bootui-micronaut-sample-app, which declares micronaut-jackson-databind and runs the same smoke
             assertions — the two stacks are mutually exclusive on one classpath, so they are covered by two
             modules rather than two profiles. -->
        <dependency>
            <groupId>io.micronaut.serde</groupId>
            <artifactId>micronaut-serde-jackson</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micronaut.test</groupId>
            <artifactId>micronaut-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A server runtime for the tests only: they boot the console on a real port under @MicronautTest.
             A consumer picks its own, which is exactly why this is not a compile dependency above. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-server-netty</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2, test-only: the in-memory datasource TestDataSourceFactory publishes so the tests that configure
             Flyway and Liquibase against a real DataSource bean can prove the two panels light up on a configured
             migration (and, on the very same classpath without that configuration, stay dark). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The shared, framework-neutral HTTP conformance contract. bootui-micronaut-sample-app runs it on
             micronaut-jackson-databind; MicronautSerdeApiConformanceTest here runs the very same suite on
             micronaut-serde-jackson, so the promise that both JSON stacks answer one identical wire contract
             is proven by the contract itself rather than by a smoke test. -->
        <dependency>
            <groupId>com.julien-dubois.bootui</groupId>
            <artifactId>bootui-conformance</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                micronaut-kafka and micronaut-rabbitmq each declare an ExecutorConfiguration bean named "consumer",
                so any context that sees both fails to start with "Multiple possible bean candidates found:
                [ExecutorConfiguration, ExecutorConfiguration]" — with or without BootUI. Both are provided-scope here
                purely to compile the two capture bindings, and provided scope also puts them on the test classpath,
                where, unlike in any real application, they would meet. The tests therefore run twice: the main run
                carries Kafka (so the context-booting tests boot with a messaging integration present, and
                RabbitController's absent path is exercised for real), and a second run carries RabbitMQ for the
                RabbitMQ capture tests alone. Neither run ever sees both.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Each run is split two ways, and both are needed. The file pattern keeps the other
                        run's tests out of JUnit discovery, which would otherwise fail to load a class whose
                        integration is off this classpath. The JUnit tag then covers the case the pattern
                        cannot: -Dtest=SomeTest overrides <includes>/<excludes> but is combined with
                        <groups>, so running a single test from the command line would otherwise run it in
                        both executions and fail in whichever one lacks the integration it needs.
                    -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>io.micronaut.rabbitmq:micronaut-rabbitmq</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <excludes>
                        <exclude>**/rabbit/*Test.java</exclude>
                    </excludes>
                    <excludedGroups>rabbitmq</excludedGroups>
                </configuration>
                <executions>
                    <execution>
                        <id>rabbitmq-capture</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>io.micronaut.kafka:micronaut-kafka</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <excludes combine.self="override" />
                            <includes>
                                <include>**/rabbit/*Test.java</include>
                            </includes>
                            <excludedGroups combine.self="override" />
                            <groups>rabbitmq</groups>
                            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
